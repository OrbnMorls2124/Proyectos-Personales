{
  "name": "nova-commerce/professional-mvc-shop",
  "description": "Tienda virtual empresarial en PHP 8 MVC, MySQL, APIs REST y UI responsive.",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/helpers/helpers.php"
    ]
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:8000 -t public",
    "sync-products": "php artisan-sync.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
